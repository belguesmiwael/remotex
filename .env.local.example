# RemoteX — Environment Variables
# Copy to .env.local and fill in values

# Socket.io server URL (default: localhost:3001)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional: enable eye tracking module (true/false)
NEXT_PUBLIC_EYE_TRACKING=false

# For production VPS deployment:
# NEXT_PUBLIC_SOCKET_URL=https://your-server.com
# ALLOWED_ORIGIN=https://your-frontend.com
